{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.jks)",
      "Read(*.keystore)",
      "Read(.npmrc.local)",
      "Read(credentials*.json)",
      "Read(client_secret*.json)",
      "Read(service-account*.json)",
      "Read(*.db)",
      "Read(*.sqlite)",
      "Read(*.sqlite3)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(*.pem)",
      "Edit(*.key)",
      "Edit(*.p12)",
      "Edit(*.pfx)",
      "Edit(*.jks)",
      "Edit(*.keystore)",
      "Edit(.npmrc.local)",
      "Edit(credentials*.json)",
      "Edit(client_secret*.json)",
      "Edit(service-account*.json)",
      "Edit(*.db)",
      "Edit(*.sqlite)",
      "Edit(*.sqlite3)",
      "Edit(!.env.example)",
      "Edit(!.env.sample)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push *:main)",
      "Bash(git push *:master)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *refs/heads/master*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --mirror*)",
      "Bash(git push --all*)",
      "Read(/secrets/**)",
      "Read(/credentials/**)",
      "Read(/private/**)",
      "Read(/uploads/**)",
      "Read(/recordings/**)",
      "Read(/transcripts/**)",
      "Read(/data/private/**)",
      "Read(/data/uploads/**)",
      "Read(/data/recordings/**)",
      "Edit(/secrets/**)",
      "Edit(/credentials/**)",
      "Edit(/private/**)",
      "Edit(/uploads/**)",
      "Edit(/recordings/**)",
      "Edit(/transcripts/**)",
      "Edit(/data/private/**)",
      "Edit(/data/uploads/**)",
      "Edit(/data/recordings/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "./**/.env",
        "./**/.env.*",
        "./**/*.pem",
        "./**/*.key",
        "./**/*.p12",
        "./**/*.pfx",
        "./**/*.jks",
        "./**/*.keystore",
        "./**/.npmrc.local",
        "./**/credentials*.json",
        "./**/client_secret*.json",
        "./**/service-account*.json",
        "./**/*.db",
        "./**/*.sqlite",
        "./**/*.sqlite3",
        "~/.ssh",
        "~/.aws",
        "~/.config/gh/hosts.yml",
        "~/.config/gcloud",
        "./secrets/**",
        "./credentials/**",
        "./private/**",
        "./uploads/**",
        "./recordings/**",
        "./transcripts/**",
        "./data/private/**",
        "./data/uploads/**",
        "./data/recordings/**"
      ],
      "allowRead": [
        "./.env.example",
        "./.env.sample"
      ]
    }
  }
}

# Vzor proměnných prostředí. Skutečné hodnoty patří do správce tajemství hostingu, nikdy do gitu.

# Postgres pro hosting (Neon). Bez hodnoty běží lokální PGlite v ./.data/pglite.
DATABASE_URL=

# Podpis session, aspoň 32 náhodných znaků. Na hostingu povinné.
SESSION_SECRET=

# Přístupový kód do hostovaného dema, aspoň 12 znaků. Lokálně bez hodnoty = bez brány.
DEMO_ACCESS_CODE=

# Veřejná adresa Wiki pro odkaz v pozvánce. Nepovinné.
APP_URL=https://wiki.example.invalid

# "real" = skutečný čas. Bez hodnoty běží ukázkový čas ze seedu (12. 11. 2026 9:00).
DEMO_CLOCK=

# Umělé zpoždění simulací v ms, aby byl v UI vidět průběh. Výchozí 1200.
SIM_LATENCY_MS=
